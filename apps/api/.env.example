# ── NEXORA API — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME="NEXORA API"
APP_VERSION=0.1.0

# Security (generate with: openssl genrsa -out private.pem 2048)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-64
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://nexora:nexora_dev@localhost:5432/nexora
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
